<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#303238">

    <!-- Данные -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Новая группа"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />
    <!-- Данные -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Заполните данные, чтобы создать группу"
        android:textColor="#8B84A8"
        android:textSize="14sp" />

    <!-- Поле ввода -->
    <EditText
        android:id="@+id/etGroupName"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Название группы (например, 2-ИП-4-25)"
        android:textColorHint="#A9A3C2"
        android:textColor="#2E2A3B"
        android:singleLine="true"
        android:inputType="text"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:backgroundTint="#EDE8F9"
        android:backgroundTintMode="src_over"
        android:elevation="1dp" />

    <!-- Кнопка создания -->
    <Button
        android:id="@+id/btnCreateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Создать группу"
        android:backgroundTint="#9C27B0"
        android:textColor="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Созданные группы:"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <!-- СПИСОК ГРУПП-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false" />
    <!-- Кнопка назад -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#757575"
        android:text="Назад на главную"
        android:textColor="#FFFFFF" />

</LinearLayout>