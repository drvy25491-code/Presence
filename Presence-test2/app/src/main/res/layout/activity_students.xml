<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#303238">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_effect"
        android:text="Новый студент"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Заполните данные и выберите группу"
        android:textColor="#8B84A8"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etLastName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Фамилия"
        android:textColorHint="#A9A3C2"
        android:singleLine="true"
        android:inputType="text"
        android:textColor="#2E2A3B"
        android:minHeight="54dp"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:backgroundTint="#EDE8F9"
        android:backgroundTintMode="src_over"
        android:elevation="1dp" />

    <EditText
        android:id="@+id/etFirstName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:hint="Имя"
        android:textColorHint="#A9A3C2"
        android:textColor="#2E2A3B"
        android:minHeight="54dp"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:backgroundTint="#EDE8F9"
        android:backgroundTintMode="src_over"
        android:elevation="1dp" />

    <Spinner
        android:id="@+id/spinnerGroups"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="1dp" />

    <Button
        android:id="@+id/btnAddStudent"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#1E90FF"
        android:text="Добавить студента"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Созданные студенты:"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#757575"
        android:text="Назад на главную"
        android:textColor="#FFFFFF" />

</LinearLayout>
