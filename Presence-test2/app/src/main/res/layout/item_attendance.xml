<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- Имя студента (занимает всё свободное место слева) -->
    <TextView
        android:id="@+id/tvStudentNameAttendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="#000000"
        android:textStyle="bold" />

    <!-- Группа радиокнопок (прижата вправо) -->
    <RadioGroup
        android:id="@+id/rgStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbPresent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Был" />

        <RadioButton
            android:id="@+id/rbAbsent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Не был"
            android:layout_marginStart="8dp"/>

        <RadioButton
            android:id="@+id/rbLate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Опоздал"
            android:layout_marginStart="8dp"/>
    </RadioGroup>

</LinearLayout>